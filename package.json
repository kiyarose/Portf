{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "description": "Kiya Rose portfolio (kiyarose/Portf) — Astro fork of SillyLittleTech/Portf",
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "sync:remote-data": "node scripts/sync-remote-data.mjs",
    "predev": "npm run sync:remote-data && node scripts/generate-icon-bundle.mjs",
    "prebuild": "npm run sync:remote-data && node scripts/generate-icon-bundle.mjs",
    "prebuild:pages": "npm run sync:remote-data",
    "dev": "astro dev",
    "build": "astro build && npm run build:tools",
    "build:tools": "vite build --config vite.tools.config.mjs",
    "build:pages": "BASE_PATH=/Portf/ astro build && BASE_PATH=/Portf/ npm run build:tools",
    "build:pages:help": "echo \"\\nTEMPLATE USERS: build:pages sets BASE_PATH=/Portf/ for GitHub Pages sub-path deploys.\\nIf your repo has a different name, replace /Portf/ with /<your-repo-name>/ in this script\\nand in the BASE_PATH env var in .github/workflows/github-pages.yml.\\nDeploying to a root domain? Use 'npm run build' instead (no sub-path needed).\\n\"",
    "lint": "astro check",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:security-headers": "node scripts/verify-security-headers.mjs",
    "data:to-json": "node src/tools/data-converter.mjs to-json",
    "data:to-ts": "node src/tools/data-converter.mjs to-ts",
    "data:publish": "node scripts/publish-r2-data.mjs",
    "data:sync:remote": "node scripts/sync-remote-data.mjs",
    "upstream:setup": "node scripts/upstream-setup.mjs",
    "upstream:status": "node scripts/upstream-status.mjs",
    "upstream:import-code": "node scripts/upstream-import-code.mjs",
    "upstream:resolve-conflicts": "node scripts/resolve-upstream-conflicts.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/json": "^2.2.560",
    "@iconify/react": "^6.0.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tmp": "^0.2.7",
    "wrangler": "^4.166.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "lychee": "^0.2.12",
    "postcss": "^8.5.33",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "cookie": "2.0.2"
  }
}