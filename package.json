{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:remote-data": "node scripts/sync-remote-data.mjs",
    "predev": "npm run sync:remote-data && node scripts/generate-icon-bundle.mjs",
    "prebuild": "npm run sync:remote-data && node scripts/generate-icon-bundle.mjs",
    "prebuild:pages": "npm run sync:remote-data",
    "dev": "astro dev",
    "build": "astro build && npm run build:tools",
    "build:tools": "vite build --config vite.tools.config.mjs",
    "build:pages": "BASE_PATH=/Portf/ astro build && BASE_PATH=/Portf/ npm run build:tools",
    "build:pages:help": "echo \"\\nTEMPLATE USERS: build:pages sets BASE_PATH=/Portf/ for GitHub Pages sub-path deploys.\\nIf your repo has a different name, replace /Portf/ with /<your-repo-name>/ in this script\\nand in the BASE_PATH env var in .github/workflows/github-pages.yml.\\nDeploying to a root domain? Use 'npm run build' instead (no sub-path needed).\\n\"",
    "lint": "astro check",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:security-headers": "node scripts/verify-security-headers.mjs",
    "data:to-json": "node src/tools/data-converter.mjs to-json",
    "data:to-ts": "node src/tools/data-converter.mjs to-ts",
    "data:publish": "node scripts/publish-r2-data.mjs",
    "data:sync:remote": "node scripts/sync-remote-data.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/json": "^2.2.553",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tmp": "^0.2.7",
    "wrangler": "^4.156.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "lychee": "^0.2.12",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.1",
    "wait-on": "^9.5.1"
  }
}
