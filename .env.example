# Environment variables for local development
# Copy this file to .env.local and set your actual values

# Pageclip API key for contact form
# Get your API key from https://pageclip.co/
VITE_PAGECLIP_API_KEY=your_pageclip_api_key_here

# Optional: remote JSON base (production builds / Cloudflare Pages). Example:
# VITE_REMOTE_DATA_URL=https://data.kiya.cat/data
#
# Optional: bypass localStorage cache for remote JSON (useful for testing).
# Set to "true" to always refetch.
# VITE_REMOTE_DATA_BYPASS_CACHE=true

# --- Remote data admin editor (opt-in; protect /admin/ with Cloudflare Access) ---
# PF_ALLOW_NOEDIT=1
# PF_EDADMIN_TOKEN=your_write_token_here
# PF_DATA_BASE_URL=https://data.kiya.cat/data
# Optional: long-press admin link target when the editor is enabled.
# VITE_ADMIN_URL=/admin/edit